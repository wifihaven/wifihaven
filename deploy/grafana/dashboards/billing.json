{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "WifiHaven Stripe billing (#2135, multi-tenant P5-5): webhook processing outcomes and Checkout/Portal starts. Panels target wifihaven_billing_webhook_total{outcome} and wifihaven_billing_checkout_total{kind,outcome} emitted by AppMetrics.recordBillingWebhook / recordBillingCheckout in api/src/routes/BillingRoutes.scala — labels are bounded enums (never per-customer / per-household / per-price). Statuses are beta/active/lapsed with NO read-only gating on lapse (design docs/design/multi-tenant-launch.md §5).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "title": "Invalid-signature webhooks (cumulative)",
      "description": "sum(wifihaven_billing_webhook_total{outcome=\"invalid_signature\"}) — rejected unsigned/forged/replayed webhook deliveries. A nonzero climb warrants a look (misconfigured signing secret, or someone probing the endpoint).",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(wifihaven_billing_webhook_total{env=\"$env\",outcome=\"invalid_signature\"})",
          "legendFormat": "invalid_signature",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "title": "Webhook processing rate by outcome",
      "description": "sum by (outcome) (rate(wifihaven_billing_webhook_total[5m])) — active (conversion/recovery) / lapsed (dunning) / ignored / unmatched / invalid_signature / not_configured per second. A rising lapsed share is the dunning signal; unmatched means an event referenced a customer with no household row.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (outcome) (rate(wifihaven_billing_webhook_total{env=\"$env\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "title": "Conversions & lapses (cumulative)",
      "description": "sum by (outcome) (wifihaven_billing_webhook_total{outcome=~\"active|lapsed\"}) — total active-flips (checkout/recovery) vs lapses over the window. The subscription funnel's two terminal transitions.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (outcome) (wifihaven_billing_webhook_total{env=\"$env\",outcome=~\"active|lapsed\"})",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "title": "Checkout / Portal starts by outcome",
      "description": "sum by (kind,outcome) (rate(wifihaven_billing_checkout_total[5m])) — checkout vs portal session starts, split ok / no_customer / stripe_error / not_configured / no_billing_row. A rising no_customer means households reached checkout without a provisioning-time Stripe Customer; stripe_error means the Stripe API call failed.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (kind, outcome) (rate(wifihaven_billing_checkout_total{env=\"$env\"}[5m]))",
          "legendFormat": "{{kind}}/{{outcome}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["wifihaven", "billing", "multi-tenant"],
  "templating": {
