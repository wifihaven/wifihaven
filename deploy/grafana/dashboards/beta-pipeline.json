{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "WifiHaven beta onboarding pipeline (#2132, multi-tenant P5-2): request intake, operator approve/reject, and invite accept outcomes. Most panels target wifihaven_beta_pipeline_total{stage,outcome} emitted by AppMetrics.recordBetaPipeline in api/src/routes/BetaRoutes.scala; the invite-email panel targets beta_invite_email_total{outcome} emitted by AppMetrics.betaInviteEmail from Notifier.betaInvite (#2190). All labels are bounded enums (never per-email / per-household). See docs/design/multi-tenant-launch.md §3.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "title": "Intake requests accepted (cumulative)",
      "description": "sum(wifihaven_beta_pipeline_total{stage=\"request\",outcome=\"created\"}) — total distinct beta requests taken in (duplicates excluded). The operator's queue depth proxy.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(wifihaven_beta_pipeline_total{env=\"$env\",stage=\"request\",outcome=\"created\"})",
          "legendFormat": "created",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "title": "Intake rate by outcome",
      "description": "sum by (outcome) (rate(wifihaven_beta_pipeline_total{stage=\"request\"}[5m])) — created / duplicate / rate_limited per second. A rising rate_limited share means the public form is being hammered.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (outcome) (rate(wifihaven_beta_pipeline_total{env=\"$env\",stage=\"request\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "title": "Operator decisions (approve / reject)",
      "description": "sum by (stage,outcome) (rate(wifihaven_beta_pipeline_total{stage=~\"approve|reject\"}[5m])) — provisioning throughput and any not_pending / error decisions.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (stage, outcome) (rate(wifihaven_beta_pipeline_total{env=\"$env\",stage=~\"approve|reject\"}[5m]))",
          "legendFormat": "{{stage}}/{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "title": "Invite accept outcomes",
      "description": "sum by (outcome) (rate(wifihaven_beta_pipeline_total{stage=\"accept\"}[5m])) — ok vs invalid_token / expired / weak_password / error. A spike in invalid_token/expired can mean stale or leaked invite links.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (outcome) (rate(wifihaven_beta_pipeline_total{env=\"$env\",stage=\"accept\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "title": "Invite email send outcomes (#2190)",
      "description": "sum by (outcome) (rate(beta_invite_email_total[5m])) — the auto-sent invite email on approval (Notifier.betaInvite). sent vs failed (transport error, fail-open — approval still committed) vs skipped_disabled (Resend secrets unset, e.g. self-hosted). A persistent 'failed' share means invites aren't reaching requesters — the operator falls back to the inviteUrl in the approve response.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (outcome) (rate(beta_invite_email_total{env=\"$env\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["wifihaven", "beta", "multi-tenant"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "prod", "value": "prod" },
        "hide": 0,
        "includeAll": false,
        "label": "Environment",
        "multi": false,
        "name": "env",
        "options": [
          { "selected": true, "text": "prod", "value": "prod" },
          { "selected": false, "text": "staging", "value": "staging" }
        ],
        "query": "prod,staging",
        "skipUrlSync": false,
        "type": "custom"
      },
      {
        "current": { "selected": true, "text": "grafanacloud-wifihaven-prom", "value": "grafanacloud-prom" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "WifiHaven — Beta onboarding pipeline",
  "uid": "wifihaven-beta-pipeline",
  "version": 1,
  "weekStart": ""
}
