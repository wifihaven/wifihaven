      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (op, result) (rate(router_ws_frames_total{env=\"$env\",result=~\"reject|unknown_op\"}[5m]))",
     "legendFormat": "{{op}} {{result}}",
     "refId": "A"
    }
   ]
  },
  {
   "datasource": {
