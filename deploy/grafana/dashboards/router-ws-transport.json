   "title": "Agent ws link state by router (ws_state) (#1848)",
   "description": "max by (router_id) (ws_state) \u2014 the wifihaven-ws sidecar's link gauge folded into the agent /metrics push: 1 = a live websocket to the API, 0 = disconnected (running on the HTTP fallback path). One series per router_id (bounded fleet dimension). This is the agent's own view of link health, complementing the server-side router_ws_connections_active gauge.",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "id": 5,
   "fieldConfig": {
