[Unit]
Description=WifiHaven API server
Documentation=https://github.com/wifihaven/wifihaven
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=wifihaven
Group=wifihaven
WorkingDirectory=/opt/wifihaven
EnvironmentFile=-/etc/wifihaven/api.env
ExecStart=/usr/bin/java \
  -Xms256m -Xmx512m \
  -Dconfig.file=/etc/wifihaven/application.conf \
  -jar /opt/wifihaven/api.jar
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wifihaven-api

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/wifihaven /var/lib/wifihaven
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
