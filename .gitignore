# Mill
out/
.mill-version
.bsp/

# Scala
*.class
*.tasty
*.jar
target/

# IDE
.idea/
.vscode/
*.iml
.metals/
.bloop/

# Node / React
# Bare `node_modules/` as well as the web/ one: running a node tool from the
# repo root (rather than from web/) creates a top-level node_modules that
# `web/node_modules/` does not cover, and a broad `git add` will sweep its
# cache blobs in.
node_modules/
web/node_modules/
web/dist/
web/.vite/
web/build/
*.tsbuildinfo

# Config (contains secrets)
config/application.conf
config/*.conf
!config/application.conf.example
deploy/.env
deploy/.env.*
!deploy/.env.example

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Test artifacts
coverage/
.coverage/

# Postgres data (if running locally)
pgdata/

# Mill 1.x temp files (mktemp pattern)
mill.??????

# VM e2e harness scratch
.e2e-vm-venv/
.e2e-vm-artifacts/
scripts/e2e/**/__pycache__/

# OpenWRT package build artifacts (produced by openwrt/build-ipk.sh,
# openwrt/build-apk.sh, and scripts/vm/build-router-image.sh). Repackaged
# from openwrt/files/ on every build; not source.
openwrt/wifihaven_*.ipk
openwrt/wifihaven_*.apk
.venv-test/
