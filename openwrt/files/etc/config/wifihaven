config wifihaven 'wifihaven'
	# Base URL of the wifihaven API server (HTTP, no trailing slash)
	option api_url 'http://192.168.1.1:8080'

	# Base URL of the public SPA that serves the /blocked page (no trailing
	# slash). The block page redirects blocked clients here. Leave unset to
	# fall back to api_url — correct for self-hosted installs, where the SPA is
	# bundled into the API image and served on the same host. In the cloud
	# deploy the SPA is on a SEPARATE host (Cloudflare Pages), so set this to
	# the public SPA host, e.g. 'https://wifihaven.net' (post-#1171 cutover:
	# 'https://app.wifihaven.net'). This is router-side config, not on the
	# API↔router wire. (#1174)
	# option block_page_url 'https://wifihaven.net'

	# Long-lived router bearer token obtained during enrollment
	option router_token ''

	# Router UUID returned during enrollment
	option router_id ''

	# LAN subnet prefix used to identify outbound (egress) flows
	option lan_prefix '192.168.1.'

	# Optional v6 LAN prefix override (#1688/#1796). NOT required: as of #1796
	# outbound v6 flows are identified by NDP-neighbor membership (the agent's
	# existing ip->mac table), which covers GUA / ULA / privacy addresses and
	# the ISP-dynamic GUA prefix automatically. Leave unset. Authoring a value
	# here only ADDS an extra prefix-match accept path (union); it cannot fix v6
	# on its own because devices source internet traffic from their GUA, not the
	# ULA, and the GUA prefix is delegated/dynamic.
	# option lan_prefix_v6 'fdaa:bbbb:cccc:'

	# How many connection_attempt events to accumulate before flushing
	option event_batch_size '50'

	# Force-flush the event batch after this many seconds even if not full
	option event_flush_interval '10'

	# How often (seconds) to poll for a new policy snapshot
	option policy_poll_interval '5'

	# How often (seconds) to POST usage counters
	option usage_report_interval '60'

	# How often (seconds) to push the agent's cumulative observability metrics
	# (counters/gauges/histograms) to /api/router/metrics. Runs on its own timer,
	# independent of the policy poll. Counters are never reset on the agent — a
	# missed push self-heals on the next success (the server re-bases off
	# agentStartedAt). See docs/design/metrics-observability.md.
	option metrics_report_interval '60'

	# How often (seconds) to sample per-MAC activity for activeSeconds
	# accounting. Must evenly divide usage_report_interval to avoid partial
	# buckets at report boundaries (e.g. 10 with usage_report_interval=60
	# yields 6 samples per report). See docs/router-tuning.md.
	option activity_sample_int '10'

	# #2024 idle-heartbeat cadence (seconds). The conntrack watcher's
	# cooperative timers — the usage flush AND activity_sample_int above, plus
	# the policy poll, nflog drain, and metrics push — all run inside on_tick,
	# which fires once per `conntrack -E -e NEW` line. On a quiet LAN (one
	# device on a long-lived websocket/stream emits no NEW events) on_tick
	# would stall for minutes, ballooning the usage window and starving the
	# sampler (the #2016 over-count). The watcher multiplexes a heartbeat line
	# into the conntrack stream every conntrack_tick_interval seconds so
	# on_tick fires on a wall-clock cadence regardless of traffic. Keep this
	# well below activity_sample_int so sampling stays on-cadence. Default 1.
	# See docs/router-tuning.md.
	option conntrack_tick_interval '1'

# SNI sidecar (wifihaven-sni-tail) toggle. Lives in its own `config sni`
# section, distinct from the `config wifihaven 'wifihaven'` anchor above —
# the init script reads it as `wifihaven.sni.enabled` via
# `config_get … sni enabled '1'`. The sidecar captures the first packet of
# every outbound TCP/443 flow via tcpdump-mini to attribute DoH /
# hard-coded-IP traffic to a hostname (#573). On constrained or
# misconfigured hardware an operator can disable it per-router without
# uninstalling: `uci set wifihaven.sni.enabled=0 && /etc/init.d/wifihaven
# restart`. This is local agent config — NOT a policy-snapshot field.
# (#1654)
config sni 'sni'
	option enabled '1'

# #2381 enforcement escape hatch. Lives in its own named `config settings
# 'settings'` section, read as `wifihaven.settings.enforcement_disabled`. When
# set to '1' the agent SHORT-CIRCUITS all enforcement on the next apply: every
# nftables forward-drop (per-MAC blocks, extraBlocked, category blocklists,
# blockIpOnly) AND the block-page HTTP DNAT are torn down, so ALL forwarded
# traffic passes. This is the LOCAL, OFFLINE escape hatch — it is re-read fresh
# on every apply cycle and is INDEPENDENT of the policy snapshot, so it works
# even when the API server is unreachable (a server outage, a bad policy, or
# "the internet is broken and I need it back NOW"). Unlike the ws/sni toggles it
# does NOT require a service restart — the agent applies the change within one
# poll cycle. Toggle it from the CLI with the one-word helpers:
#   wifihaven-disable   # turn OFF all blocking (bypass on)
#   wifihaven-enable    # restore normal enforcement (bypass off)
# or directly: `uci set wifihaven.settings.enforcement_disabled=1 && uci commit
# wifihaven`. Also exposed as a labelled toggle in LuCI (Services -> WifiHaven
# -> Settings). The server-driven per-household equivalent is #2382, which needs
# the API to be up; THIS hatch is the fallback for when it is not. See
# docs/escape-hatch.md.
config settings 'settings'
	option enforcement_disabled '0'

# Websocket transport sidecar (wifihaven-ws) toggle + tuning (#1848). Lives in
# its own named `config ws 'ws'` section, read as `wifihaven.ws.<opt>`. DEFAULT
# ON as of #2608, now that the transport is proven in the field: `enabled` is
# deliberately NOT written here, and every reader (the agent, the sidecar, the
# init script) treats an UNSET value as '1'. Leaving the key absent is what
# makes "the operator never expressed an opinion" observable — a literal '0' in
# this file would be indistinguishable from a hand-authored opt-out, which is
# exactly the ambiguity /etc/uci-defaults/97-wifihaven-ws-default-on resolves
# on upgrade.
#
# To opt a router OUT and stay on the HTTP poll path:
#   uci set wifihaven.ws.enabled=0 && uci commit wifihaven \
#     && /etc/init.d/wifihaven restart
# That choice is durable: the migration records a one-shot
# `default_on_migrated` marker and never rewrites `enabled` again. The poll path
# is unchanged and remains the automatic fallback whenever the sidecar is down
# past `fallback_after` below (design §3.1). This is local agent config — NOT a
# policy-snapshot field.
config ws 'ws'
	# Heartbeat ping/pong cadence (seconds). Pinned below Render's ws idle
	# timeout by the #1845 spike (design §5.5). The server closes a channel
	# that misses a pong for 2× this.
	option heartbeat_interval '30'
	# Sidecar loop tick (seconds) — how long the connected loop blocks in the
	# inbound recv before draining the outbound spool again (#2620). Separate
	# from heartbeat_interval on purpose: the heartbeat is liveness, this is
	# outbound latency. Before #2620 the recv timeout WAS the tick, so a drop
	# event spooled just after a drain waited up to heartbeat_interval (30s)
	# to leave the router — the dominant hop in the ~26s drop-to-SPA delay.
	#
	# The key is deliberately NOT written here. Its default is single-sourced at
	# ws_loop.DEFAULT_POLL_INTERVAL (1 s, matching conntrack_tick_interval so the
	# sidecar and the agent tick together), which wifihaven-ws reads as its
	# uci_get default — writing a literal here would fork that default and a
	# later bump to the constant would silently not reach a fresh install. To
	# override on one router:
	#   uci set wifihaven.ws.poll_interval=2 && uci commit wifihaven \
	#     && /etc/init.d/wifihaven restart
	# Clamped into [ws_loop.MIN_POLL_INTERVAL, heartbeat_interval] at runtime
	# (the clamped value is what the sidecar logs at startup); a value at/above
	# heartbeat_interval restores the pre-#2620 shape. Costs one tmpfs spool
	# read per interval on an idle socket.
	# How long (seconds) the socket may stay down before the main agent resumes
	# HTTP polling (design §3.1 belt-and-suspenders). The agent reads the
	# ws-health sentinel's mtime against this window.
	option fallback_after '300'
	# Self-imposed max bytes per outbound frame. An oversized UsageReport is
	# split across multiple `usage` frames at this cap (the #1017 fix, §5.3).
	option max_frame_bytes '65536'
	# Connect + TLS-handshake timeout (seconds) per attempt.
	option connect_timeout '10'
	# Byte cap on the outbound frame spool (/tmp = tmpfs = RAM). The agent
	# drops OLDEST frames first when the sidecar can't keep up, so a wedged
	# socket can never grow tmpfs without bound (router-agent-bounded-writes).
	option spool_max_bytes '1048576'
