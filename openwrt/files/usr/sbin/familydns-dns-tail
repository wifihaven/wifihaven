#!/usr/bin/lua
-- familydns-dns-tail — sidecar daemon that tails dnsmasq's query log and
-- maintains the ip → hostname cache the main agent reads for connection-event
-- attribution. Run as a separate procd instance so the main agent can stay on
-- its blocking conntrack read without needing non-blocking-I/O primitives
-- (#259). The cache snapshot is written atomically to /tmp so the agent can
-- read it whenever a new flow arrives.

local uci      = require("uci")
local dns_log  = require("familydns.dns_log")
local log      = require("familydns.log")

local cursor = uci.cursor()
local function uci_get(opt, default)
  return cursor:get("familydns", "@familydns[0]", opt) or default
end

local debug_opt   = uci_get("debug", "0")
local source_path = "/tmp/familydns-dnsmasq.log"
local cache_path  = "/tmp/familydns-dns-cache.txt"
local tmp_path    = cache_path .. ".tmp"
-- Flush after every ingested line: the agent's conntrack watcher reads the
-- cache file at flow-start time (SYN → conntrack -E NEW), which lands
-- milliseconds after the dnsmasq reply line that resolved the destination
-- IP. Any flush delay here means lookup_hostname() returns nil and the
-- connection_attempt event is built with hostname=nil — and that hostname
-- is frozen on the event before it's queued / POSTed, so a later flush
-- can't repair it (#472). Tail+ingest is line-driven and tmpfs writes are
-- cheap, so flushing every line is the cheapest correct behavior.
local flush_every = 1  -- lines

log.init({ debug = debug_opt })
log.info("dns-tail: starting source=%s cache=%s", source_path, cache_path)

local cache = dns_log.new({ ttl_seconds = 3600 })

-- tail -F follows the log across rotations (dnsmasq SIGHUP, file replaced).
-- -n 0 skips replay of the historical log so we don't burn CPU at boot.
local handle = io.popen(string.format(
  "tail -n 0 -F %q 2>/dev/null", source_path), "r")
if not handle then
  log.err("dns-tail: cannot start tail on %s", source_path)
  os.exit(1)
end

local function atomic_write(path, content)
  local f, err = io.open(tmp_path, "w")
  if not f then
    log.err("dns-tail: open %s failed: %s", tmp_path, tostring(err))
    return false
  end
  f:write(content)
  f:close()
  local ok = os.rename(tmp_path, path)
  if not ok then
    log.err("dns-tail: rename %s -> %s failed", tmp_path, path)
    os.remove(tmp_path)
    return false
  end
  return true
end

local since_flush      = 0
local last_tick        = os.time()
local last_stats_log   = os.time()
local lines_ingested   = 0
local lines_since_stat = 0

while true do
  local line = handle:read("*l")
  if not line then
    log.warn("dns-tail: tail pipe closed; exiting (procd will respawn)")
    break
  end
  cache.ingest_line(line)
  since_flush      = since_flush + 1
  lines_ingested   = lines_ingested + 1
  lines_since_stat = lines_since_stat + 1

  local now = os.time()
  if since_flush >= flush_every or (now - last_tick) >= 30 then
    cache.tick(now)
    atomic_write(cache_path, cache.dump_text())
    log.debug("dns-tail: flushed cache size=%d", cache.size())
    since_flush = 0
    last_tick   = now
  end

  -- One-line info heartbeat so silent failures (dnsmasq not logging, tail
  -- dropping the pipe, regex never matching) are diagnosable from logread
  -- alone without on-VM access (#480).
  if (now - last_stats_log) >= 60 then
    log.info("dns-tail: ingested=%d (+%d in last %ds) cache_size=%d",
             lines_ingested, lines_since_stat, now - last_stats_log, cache.size())
    last_stats_log   = now
    lines_since_stat = 0
  end
end

handle:close()
