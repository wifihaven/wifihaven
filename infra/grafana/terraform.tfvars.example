# Copy to terraform.tfvars (gitignored) and fill in, OR export as TF_VAR_*.
# Both values are secrets — terraform.tfvars is gitignored; never commit real
# values. In CI these come from the GRAFANA_URL / GRAFANA_AUTH GitHub Actions
# secrets (see .github/workflows/deploy-grafana.yml).

grafana_url  = "https://<your-stack>.grafana.net"
grafana_auth = "<Grafana service-account token — Administration → Service accounts>"
