# State files: now stored remotely on HCP Terraform (the `cloud {}` block in
# main.tf, #1406). Any *.tfstate left locally is a stale/transient artifact
# (e.g. the pre-migration local backend) and must never be committed — it can
# hold per-resource sensitive values.
*.tfstate
*.tfstate.*

# Plugin cache. Large; restored by `terraform init`.
.terraform/

# tfvars: contains the Grafana service-account token and stack URL — both
# secrets. Never committed (unlike infra/cloudflare, where the tfvars IDs are
# non-secret). CI supplies these via the GRAFANA_URL / GRAFANA_AUTH secrets.
terraform.tfvars
