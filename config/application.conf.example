wifihaven {
  db {
    host     = "localhost"
    port     = 5432
    database = "wifihaven"
    user     = "wifihaven"
    password = "changeme"
    poolSize = 5

    # #1255: tolerate a transient DB outage (a few-second restart during a plan
    # resize / failover / network blip) instead of crashing the process. The
    # DB-heavy startup init (migrations + seeds) retries connection-class errors
    # with bounded exponential backoff + jitter while /api/health stays 503;
    # genuine errors (a bad migration, a constraint violation) still fail fast.
    # The whole block is optional — omit it to use the defaults shown here.
    # resilience {
    #   startupRetryBaseMillis        = 1000   # base backoff between retries
    #   startupRetryMaxBackoffSeconds = 30     # cap on a single backoff delay
    #   startupRetryMaxElapsedSeconds = 300    # total retry budget before failing loudly
    #   # Hikari initializationFailTimeout. Negative => create the pool even if the
    #   # DB is down at boot (connections established lazily), so pool creation can
    #   # never take the process down during a DB blip.
    #   initializationFailTimeoutMillis = -1
    #   connectionTimeoutMillis         = 30000
    # }
  }

  http {
    host      = "0.0.0.0"
    port      = 8080
    staticDir = "web/dist"
    # #614: serve the bundled SPA from this JVM. Default true preserves
    # local-dev and self-hosted single-origin installs. Set to false on
    # cloud API deployments where the SPA is served by a CDN (Render
    # Static Sites / Cloudflare Pages) — non-/api/* paths return 404.
    serveSpa  = true
  }

  jwt {
    secret      = "change-this-to-a-random-32-char-secret!!"
    # #1607: 30 days. The operator hits re-login ~daily on a 24h default,
    # and this is a self-hosted home tool used from trusted devices.
    # Per-deploy override: set WIFIHAVEN_JWT_HOURS (entrypoint.sh).
    # Security trade-off: longer-lived JWTs widen blast radius on token
    # leak; bcrypt + JWT secret rotation unchanged, role claims unchanged.
    expiryHours = 720
  }

  cors {
    # Comma-separated list of full origins (scheme+host+optional-port) allowed
    # to call this API from a browser. Empty = no CORS headers emitted (the
    # default for self-hosted single-origin installs). Never use "*".
    # Example: "https://wifihaven.example,https://www.wifihaven.example"
    allowedOrigins = ""
  }

  policy {
    # #944: hostnames always present in every profile's snapshot extraAllowed
    # so a paused household member can still reach the admin UI to unpause
    # themselves. Comma-separated. Set to the SPA + API hostnames this
    # deployment serves (prod OR staging, NOT both — otherwise a prod router
    # lets staging hosts through). Empty disables the global allow list.
    # Hostname-only for now; port-aware allow/block tracked in #296.
    # Example (prod):    "wifihaven.net,www.wifihaven.net,api.wifihaven.net"
    # Example (staging): "staging.wifihaven.net,api-staging.wifihaven.net"
    # Example (dev):     "api.lan"
    # Precursor to the DB-backed global profile in #937.
    uiAllowedHosts = ""
  }

  ws {
    # #1969: SPA-websocket upgrade-auth Origin allowlist (design §8 — the one
    # server-side ws config that differs by hosting mode). Comma-separated Origin
    # HOSTS (scheme/port ignored) allowed to upgrade GET /api/ws. Wildcards: a
    # leading "*.suffix" matches any subdomain of suffix; a trailing "prefix.*"
    # matches prefix and prefix.<anything>. EMPTY disables the cross-origin check
    # entirely — the self-hosted same-origin default, where SameSite=Strict on the
    # wh_ws cookie is the CSWSH guard. Set on cloud/staging so a cross-site upgrade
    # is rejected before the 101.
    # Example (prod):    "app.wifihaven.net"
    # Example (staging): "app-staging.wifihaven.net,staging.wifihaven.net"
    # Example (dev):     "localhost"
    allowedOrigins = ""

    # #1969: cadence (seconds) at which each open ws connection re-checks the JWT's
    # exp and closes with 4401 token-expired once crossed (design §4.3). Clamped to
    # a 1s floor. Default 30s mirrors the app-level heartbeat.
    # expiryCheckSeconds = 30
  }

  metrics {
    # #1242: Prometheus exposition at GET /metrics (JVM + runtime + app
    # gauges/counters). enabled=false leaves the route unmounted.
    enabled = true
    # When set, GET /metrics requires `Authorization: Bearer <token>`.
    # Leave empty for self-hosted installs where the API isn't publicly
    # exposed; set a token on internet-facing (Render) deployments.
    scrapeToken = ""
    # #2266: set true on an internet-facing deploy to make the token MANDATORY —
    # an unset scrapeToken then FAILS BOOT instead of serving /metrics
    # unauthenticated. Leave false for a loopback-only self-hosted install.
    requireToken = false
  }

  # #2135 (multi-tenant P5-5): Stripe billing. The whole block is optional — the
  # self-hosted single-install path never bills, so the /api/billing/* admin routes
  # 404 and the webhook no-ops. Cloud/staging set these from env (secrets NEVER
  # committed — docs/process/security.md). Price ids / promo code differ between
  # Stripe test and live modes, so they are config, not constants.
  # stripe {
  #   # #2266: EXPLICIT enable flag (no dark-by-default). Billing is off unless set
  #   # true — NOT inferred from secretKey presence. When true, secretKey is REQUIRED
  #   # and an unset key FAILS BOOT (rather than silently no-opping). #2414: webhookSecret
  #   # is required under enabled=true too — without it every Stripe webhook answers 200
  #   # and no-ops, Stripe never retries, and subscription state never advances.
  #   enabled           = false
  #   secretKey         = ""   # Stripe secret API key (sk_test_… / sk_live_…) — SECRET
  #   webhookSecret     = ""   # Webhook signing secret (whsec_…) — SECRET
  #   priceMonthly      = ""   # recurring Price id, $10/mo (price_…)
  #   priceAnnual       = ""   # recurring Price id, $96/yr (price_…)
  #   foundingPromoCode = ""   # FOUNDING Promotion Code id (promo_…) — pre-applied for founding
  #   appBaseUrl        = "https://app.wifihaven.net"  # SPA origin Checkout/Portal return to
  # }

  # #2132 (multi-tenant P5-2): the beta request → provisioning → invite-accept
  # pipeline. The whole block is optional — omit it to use the defaults shown.
  # beta {
  #   # SPA origin the operator-issued invite link points at; the approve
  #   # response returns "<inviteBaseUrl>/welcome?token=…" for the operator to
  #   # send manually (no email transport is invented). Cloud default is the app
  #   # apex; self-hosted single-origin installs point it at their own SPA host.
  #   inviteBaseUrl  = "https://app.wifihaven.net"
  #   # Single-use invite token lifetime in hours (default 7 days), following the
  #   # enrollment-token conventions in docs/process/security.md.
  #   inviteTtlHours = 168
  # }

  # #2137 (multi-tenant P5-6): the beta→paid flip lifecycle. EVENT-TRIGGERED (not
  # a hand-set date): the cohort flip clock STARTS the first time `thresholdHouseholds`
  # active beta households are seen, runs `windowDays`, then unconverted households
  # flip to `lapsed` (enforcement STOPS permissively — never brick the network). The
  # whole block is optional — omit it to use the defaults shown (the design's v1
  # cohort values); tune without a code change.
  # flip {
  #   thresholdHouseholds = 25  # active beta households that start the flip clock
  #   windowDays          = 60  # free-beta window length once the clock starts
  #   activeLookbackDays  = 7   # a router's traffic within N days keeps its household "active"
  # }

  # #578: outbound email for admin notifications (a parent gets emailed when a
  # kid raises an access request from the block page). The whole block is
  # optional — omit it and email is OFF: the Notifier falls back to a log line
  # and the in-app dashboard banner remains authoritative. Sent via Resend's HTTPS
  # API (no SMTP; no new build dependency). The recipient is per-household
  # (Admin → "Request notifications"), NOT set here.
  # email {
  #   # #2266: EXPLICIT enable flag (no dark-by-default). Email is off unless set true
  #   # — NOT inferred from the secrets. When true, BOTH resendApiKey and fromAddress
  #   # are REQUIRED and an unset one FAILS BOOT (rather than silently logging).
  #   enabled      = false
  #   # Resend API key ("re_…"); sent as `Authorization: Bearer`. On Render this
  #   # comes from a secret env override (WIFIHAVEN_EMAIL_RESEND_API_KEY, rendered
  #   # into this block by docker/entrypoint.sh), never the committed config.
  #   resendApiKey = ""
  #   # Verified Resend sender, e.g. "WifiHaven <alerts@wifihaven.net>".
  #   fromAddress  = ""
  #   # SPA origin the "Review in dashboard" link in the email points at.
  #   appBaseUrl   = "https://app.wifihaven.net"
  # }

  # #2199 (support intake B, epic #2197): the Plain helpdesk integration. The whole
  # block is optional — omit it and support is OFF (DARK): the identified chat
  # widget renders nothing and the Plain write client is a no-op, so the
  # self-hosted single install is unaffected. Two independent gates, now EXPLICIT
  # flags (#2266, no dark-by-default) in the nested `plain {}` sub-block:
  #   - the WIDGET turns on only when plain.widgetEnabled = true (then plainAppId +
  #     plainIdentitySecret are REQUIRED — a missing one fails boot);
  #   - the WRITE API turns on when plain.writeEnabled = true (then plainApiKey is REQUIRED).
  # Secrets come from env on Render (WIFIHAVEN_SUPPORT_PLAIN_*, rendered into this
  # block by docker/entrypoint.sh), NEVER the committed config (docs/process/security.md).
  # support {
  #   plain {
  #     # #2266: EXPLICIT enable flags — the widget / write halves are off unless set true, NOT
  #     # inferred from secret presence. A true flag makes its secret(s) REQUIRED (fail loud on boot).
  #     widgetEnabled  = false
  #     writeEnabled   = false
  #     # Plain API key (write API — customer upsert + thread write); Authorization: Bearer. SECRET.
  #     apiKey         = ""
  #     # Plain webhook signing secret (inbound new-message HMAC verify). SECRET.
  #     webhookSecret  = ""
  #     # Plain "chat authentication" HMAC-SHA256 email-hash secret (server-signed widget identity). SECRET.
  #     identitySecret = ""
  #     # Plain chat/widget app id — public (rendered into the SPA), still per-workspace config.
  #     appId          = ""
  #     # Plain GraphQL endpoint (region-specific). Default is the UK core-api region.
  #     # apiBase      = "https://core-api.uk.plain.com/graphql/v1"
  #   }
  #
  #   # #2200: the Claude support responder — a CLOUD Claude agent (Anthropic Managed Agents
  #   # session) dispatched per UI-originated inbound Plain message. #2265: NO dark-by-default —
  #   # the responder runs only when responderEnabled = true is set EXPLICITLY, and then every
  #   # field it needs (plainApiKey, plainWebhookSecret, the three Anthropic fields,
  #   # agentTokenSecret, deploymentEnv) is REQUIRED: a missing one fails startup loudly, listing
  #   # every gap. false (the default, the self-hosted posture) is logged at boot and visible on
  #   # /api/health. issueFilingEnabled gates the GitHub bot the same way.
  #   # responderEnabled    = false
  #   # issueFilingEnabled  = false
  #   # #2300: which cloud-agent transport to dispatch through — an EXPLICIT named value (no
  #   # dark-by-default). "managed-agents" (default; Anthropic Managed Agents session, API-credit
  #   # billed) or "claude-code-cloud" (a Claude Code Cloud routine fired per message, billed
  #   # against the Claude subscription). When responderEnabled, only the SELECTED transport's
  #   # config chain below is required; an unknown value fails boot.
  #   # dispatcher          = "managed-agents"
  #   #
  #   # ── Transport: managed-agents (required when dispatcher = "managed-agents") ──
  #   # Anthropic API key — used ONLY to create agent sessions. SECRET.
  #   anthropicApiKey       = ""
  #   # The pre-provisioned Managed Agent + environment ids (deploy/support-agent/, applied once
  #   # with `ant beta:agents create` / `ant beta:environments create`).
  #   claudeAgentId         = ""
  #   claudeEnvironmentId   = ""
  #   # anthropicApiBase    = "https://api.anthropic.com"
  #   #
  #   # ── Transport: claude-code-cloud (required when dispatcher = "claude-code-cloud") ──
  #   # The pre-provisioned Claude Code Cloud routine fired per message. Create the routine ONCE in
  #   # the Claude Code web UI (https://claude.ai/code/routines): give it the support-agent system
  #   # prompt (same instructions as deploy/support-agent/), add an "API trigger" (which mints the
  #   # per-routine bearer token), and set its environment's network access to allow this API's
  #   # agentApiBase so the run can reach the /api/support/agent/* callbacks. Shares anthropicApiBase.
  #   claudeCodeRoutineId    = ""
  #   # The per-routine bearer token from the routine's API trigger (Authorization: Bearer). SECRET.
  #   claudeCodeRoutineToken = ""
  #   # HMAC secret for the per-session agent token (thread- + household-bound, short-TTL,
  #   # consent-scoped — the dispatched agent's ONLY credential). Generate ≥32 random chars. SECRET.
  #   agentTokenSecret      = ""
  #   # agentTokenTtlMinutes = 30
  #   # The public base URL of THIS API — what the cloud agent calls back to (/api/support/agent/...).
  #   # agentApiBase        = "https://api.wifihaven.net"
  #   # Which deployment this API is ("staging" | "prod"; rides in the agent kickoff so a session
  #   # knows whether it serves a real customer or an operator test). Empty on self-hosted.
  #   # deploymentEnv       = ""
  #   # Fine-grained GitHub token for the support bot — Issues:write ONLY on wifihaven/wifihaven
  #   # (no contents / no pull_requests ⇒ no-PR is structural, #2241). Required when
  #   # issueFilingEnabled = true. SECRET. (The target repo + REST base are constants, not config.)
  #   githubSupportBotToken = ""
  #   # #2429: the customer-facing support inbox this deployment publishes in the SPA — the API
  #   # ships it on GET /api/support/identity so the address has ONE source of truth (the SPA never
  #   # derives it from the hostname). support@wifihaven.net on prod, support@staging.wifihaven.net
  #   # on staging. Empty (the self-hosted default) = no hosted support desk and the SPA shows no
  #   # support line; REQUIRED when plain.widgetEnabled = true.
  #   emailAddress          = ""
  # }
}
